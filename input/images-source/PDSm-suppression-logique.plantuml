@startuml
hide footbox

skinparam sequence {
 arrowColor black
 ParticipantBorderColor RoyalBlue
 ParticipantBackgroundColor white
 LifeLineBorderColor RoyalBlue
 LifeLineBackgroundColor RoyalBlue
 ParticipantFontSize 14
 ParticipantFontName arial
 ParticipantPadding 20
}
skinparam  roundcorner 20


participant "Producteur\n de documents" as PROD
participant "Gestionnaire de partage\n de documents" as INFRA

opt état courant de la fiche (version, position des extensions) inconnu du producteur
  PROD-[#black]> INFRA : Flux 05-b **RechercheDocument** (lecture de la fiche) \n <color #FireBrick>HTTP GET [base]/DocumentReference?patient.identifier=...&status=current&identifier=...</color>
  INFRA-[#black]-> PROD : Flux 06-b **ResultatRechercheDocument** \n <color #FireBrick>HTTP 200 OK + ressource "Bundle" (DocumentReference avec meta.versionId)</color>
end

PROD-[#black]> INFRA : Flux 03 **MiseAJourMetadonneeFiche** (suppression logique) \n <color #FireBrick>HTTP PATCH [base]/DocumentReference?identifier=... + If-Match</color> \n test /status = current \n replace /status = superseded \n test /extension/n/url = PDSm_IsDeleted (si replace) \n replace ou add PDSm_IsDeleted = true
activate INFRA
activate PROD

group Vérifications (dans cet ordre)
  INFRA -> INFRA : recherche de la fiche par son identifiant :\n aucune fiche (ou fiche supprimée) : <color #FireBrick>404</color>\n plusieurs fiches : <color #FireBrick>412</color>
  INFRA -> INFRA : If-Match différent de la version courante : <color #FireBrick>412</color>
  INFRA -> INFRA : élément autre que status, securityLabel,\n PDSm_IsArchived, PDSm_IsDeleted : <color #FireBrick>405</color>
  INFRA -> INFRA : opération test en échec : <color #FireBrick>422</color>
  INFRA -> INFRA : fiche qui n'est pas la plus récente (status ≠ current)\n ou résultat différent de status = superseded\n et PDSm_IsDeleted = true : <color #FireBrick>422</color>
end

group Mise à jour de la fiche
  INFRA -> INFRA : application de la demande\n (status = superseded, PDSm_IsDeleted = true)
  INFRA -> INFRA : PDSm_IsArchived = false si la fiche était archivée
end

group Propagation
  INFRA -> INFRA : PDSm_IsDeleted = true sur les fiches remplacées\n (relatesTo.code = replaces)
  INFRA -> INFRA : versions historiques (meta.versionId)\n inaccessibles en vread et history
  INFRA -> INFRA : documents (content.attachment.url)\n inaccessibles
  INFRA -> INFRA : retrait des entrées List.entry\n dans les lots de soumission
  INFRA -> INFRA : retrait des entrées List.entry\n dans les classeurs + mise à jour de List.date
end

INFRA-[#black]-> PROD : Flux 04 **ResultatMAJMetadonneFiche** \n <color #FireBrick>HTTP 200 OK + ressource "DocumentReference"</color>
deactivate PROD
deactivate INFRA

note over PROD, INFRA
  Suppression définitive : la fiche n'est plus retournée par la recherche
  et toute nouvelle demande la concernant reçoit une erreur 404.
end note
@enduml
